<svg width="320" height="440" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 320 440">
    <foreignObject width="320" height="440">
        <div xmlns="http://www.w3.org/1999/xhtml" style="margin: 0; padding: 10px; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            <style>
                @keyframes eq-bounce-1 { 0%, 100% { height: 4px; } 50% { height: 16px; } }
                @keyframes eq-bounce-2 { 0%, 100% { height: 14px; } 50% { height: 6px; } }
                @keyframes eq-bounce-3 { 0%, 100% { height: 8px; } 50% { height: 18px; } }
                @keyframes eq-bounce-4 { 0%, 100% { height: 16px; } 50% { height: 4px; } }
                .eq-bar { width: 3px; border-radius: 2px; background: #fa233b; display: inline-block; }
                .eq-1 { animation: eq-bounce-1 0.9s ease-in-out infinite; }
                .eq-2 { animation: eq-bounce-2 0.7s ease-in-out infinite; }
                .eq-3 { animation: eq-bounce-3 1.1s ease-in-out infinite; }
                .eq-4 { animation: eq-bounce-4 0.8s ease-in-out infinite; }
                .truncate {
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
            </style>
            
            <div style="background: linear-gradient(155deg, #161224 0%, #0d1117 55%, #130d22 100%); border: 1px solid rgba(167, 139, 250, 0.28); border-radius: 20px; width: 300px; padding: 16px; box-sizing: border-box; box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.8), 0 0 20px -6px rgba(167, 139, 250, 0.25); color: #fff;">
                
                <!-- Top Header: Apple Music Badge + Equalizer -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <div style="display: flex; align-items: center; gap: 6px; background: rgba(250, 35, 59, 0.14); border: 1px solid rgba(250, 35, 59, 0.35); padding: 4px 10px; border-radius: 999px;">
                        {% if apple_icon %}
                        <img src="data:image/png;base64, {{apple_icon}}" style="width: 14px; height: 14px;"/>
                        {% else %}
                        <span style="font-size: 13px; color: #fa233b;"></span>
                        {% endif %}
                        <span style="font-size: 11px; font-weight: 700; color: #ff5e73; letter-spacing: 0.5px; text-transform: uppercase;">Apple Music</span>
                    </div>

                    <!-- Animated Sound Equalizer -->
                    <div style="display: flex; align-items: flex-end; gap: 3px; height: 18px; padding-right: 4px;">
                        <span class="eq-bar eq-1" style="height: 10px;"></span>
                        <span class="eq-bar eq-2" style="height: 14px;"></span>
                        <span class="eq-bar eq-3" style="height: 8px;"></span>
                        <span class="eq-bar eq-4" style="height: 12px;"></span>
                    </div>
                </div>

                <!-- Album Art Image -->
                <div style="width: 268px; height: 268px; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 24px -4px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.08); position: relative; background: #1c1c1e;">
                    {% if album_art %}
                    <img src="data:image/jpeg;base64, {{album_art}}" style="width: 100%; height: 100%; object-fit: cover; display: block;"/>
                    {% else %}
                    <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at center, #241432 0%, #0e0e12 100%);">
                        <div style="font-size: 48px; color: #fa233b; margin-bottom: 6px;"></div>
                        <div style="font-size: 14px; font-weight: 600; color: #a78bfa;">Apple Music Library</div>
                    </div>
                    {% endif %}
                </div>

                <!-- Track Info -->
                <div style="margin-top: 14px;">
                    <div class="truncate" style="font-size: 16px; font-weight: 700; color: #ffffff; letter-spacing: -0.2px; line-height: 1.3;" title="{{ album_name }}">
                        {{ album_name }}
                    </div>
                    <div class="truncate" style="font-size: 13px; font-weight: 500; color: #a78bfa; margin-top: 3px; line-height: 1.2;" title="{{ artist_name }}">
                        {{ artist_name }}
                    </div>
                </div>

                <!-- Stylized Progress Bar -->
                <div style="margin-top: 12px; display: flex; align-items: center; gap: 8px;">
                    <div style="flex: 1; height: 3px; background: rgba(255, 255, 255, 0.12); border-radius: 2px; overflow: hidden;">
                        <div style="width: 65%; height: 100%; background: linear-gradient(90deg, #a78bfa, #fa233b); border-radius: 2px;"></div>
                    </div>
                    <span style="font-size: 10px; color: rgba(255, 255, 255, 0.45); font-family: monospace;">NOW PLAYING</span>
                </div>

            </div>
        </div>
    </foreignObject>
</svg>